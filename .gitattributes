# Auto detect text files and perform LF normalization
* text=auto

# Store Unreal assets and media as ordinary Git binary files (no LFS).
*.uasset -text -filter -diff -merge
*.umap -text -filter -diff -merge
*.fbx -text -filter -diff -merge
*.png -text -filter -diff -merge
*.jpg -text -filter -diff -merge
*.jpeg -text -filter -diff -merge
*.tga -text -filter -diff -merge
*.wav -text -filter -diff -merge
*.mp3 -text -filter -diff -merge
*.mp4 -text -filter -diff -merge
